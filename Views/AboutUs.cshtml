@model IEnumerable<ShopingApp.Models.Student>


@{
    foreach(var items in Model)
    {
        <h2>@items.College</h2>
        <h3>@items.Department</h3>

        <a asp-action="userdetails" asp-controller="Home" asp-route-id="@items.Id">@items.Name</a>
    }
}

